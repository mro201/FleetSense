FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY app/ ./app/
COPY fleetsense/features/schema.json ./fleetsense/features/schema.json

EXPOSE 8501
CMD uv run streamlit run app/streamlit_app.py --server.port ${PORT:-8501} --server.address 0.0.0.0
